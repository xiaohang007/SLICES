+
+  subroutine c_gfnff_topology_copy_pbc(c_calculator,c_blist,c_bshift,c_vbond, &
+    &                                  c_alist,c_ashift,c_vangl,c_iostat) &
+    &   bind(C,name="c_gfnff_topology_copy_pbc")
+    implicit none
+    type(c_gfnff_calculator),intent(in) :: c_calculator
+    integer(c_int),intent(out) :: c_blist(2,*)
+    integer(c_int),intent(out) :: c_bshift(3,*)
+    real(c_double),intent(out) :: c_vbond(6,*)
+    integer(c_int),intent(out) :: c_alist(3,*)
+    integer(c_int),intent(out) :: c_ashift(6,*)
+    real(c_double),intent(out) :: c_vangl(2,*)
+    integer(c_int),intent(out) :: c_iostat
+    type(gfnff_data),pointer :: calc_ptr
+    integer :: nbond_blist
+    integer :: nbond_vbond
+    integer :: nangl
+    integer :: i,iTr
+
+    c_iostat = 1
+    if (.not.c_associated(c_calculator%ptr)) return
+    call c_f_pointer(c_calculator%ptr,calc_ptr)
+    if (.not.associated(calc_ptr)) return
+
+    nbond_blist = 0
+    nbond_vbond = 0
+    nangl = 0
+    if (allocated(calc_ptr%neigh).and.allocated(calc_ptr%neigh%blist)) then
+      nbond_blist = calc_ptr%neigh%nbond_blist
+    end if
+    if (allocated(calc_ptr%neigh).and.allocated(calc_ptr%neigh%vbond)) then
+      nbond_vbond = calc_ptr%neigh%nbond
+    end if
+    if (allocated(calc_ptr%topo).and.allocated(calc_ptr%topo%alist) &
+    &   .and.allocated(calc_ptr%topo%vangl)) then
+      nangl = calc_ptr%topo%nangl
+    end if
+
+    if (nbond_blist > 0) then
+      c_blist(1:2,1:nbond_blist) = int(calc_ptr%neigh%blist(1:2,1:nbond_blist),c_int)
+      c_bshift(1:3,1:nbond_blist) = 0
+      if (allocated(calc_ptr%neigh%trVecInt)) then
+        do i = 1,nbond_blist
+          iTr = calc_ptr%neigh%blist(3,i)
+          if (iTr > 0.and.iTr <= size(calc_ptr%neigh%trVecInt,dim=2)) then
+            c_bshift(1:3,i) = int(calc_ptr%neigh%trVecInt(1:3,iTr),c_int)
+          end if
+        end do
+      end if
+    end if
+    if (nbond_vbond > 0) then
+      if (allocated(calc_ptr%neigh%vbond_legacy)) then
+        c_vbond(1:6,1:nbond_vbond) = calc_ptr%neigh%vbond_legacy(1:6,1:nbond_vbond)
+      else
+        c_vbond(1:3,1:nbond_vbond) = calc_ptr%neigh%vbond(1:3,1:nbond_vbond)
+        c_vbond(4:6,1:nbond_vbond) = 0.0_c_double
+      end if
+    end if
+    if (nangl > 0) then
+      c_alist(1:3,1:nangl) = int(calc_ptr%topo%alist(1:3,1:nangl),c_int)
+      c_ashift(1:6,1:nangl) = 0
+      if (allocated(calc_ptr%neigh%trVecInt)) then
+        do i = 1,nangl
+          iTr = calc_ptr%topo%alist(4,i)
+          if (iTr > 0.and.iTr <= size(calc_ptr%neigh%trVecInt,dim=2)) then
+            c_ashift(1:3,i) = int(calc_ptr%neigh%trVecInt(1:3,iTr),c_int)
+          end if
+          iTr = calc_ptr%topo%alist(5,i)
+          if (iTr > 0.and.iTr <= size(calc_ptr%neigh%trVecInt,dim=2)) then
+            c_ashift(4:6,i) = int(calc_ptr%neigh%trVecInt(1:3,iTr),c_int)
+          end if
+        end do
+      end if
+      c_vangl(1:2,1:nangl) = calc_ptr%topo%vangl(1:2,1:nangl)
+    end if
+    c_iostat = 0
+  end subroutine c_gfnff_topology_copy_pbc
